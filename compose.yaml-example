services:
  postgres:
    image: erpuserside/userside:3.21-postgres
    restart: unless-stopped
    env_file:
      - ${ERP_BASE_DIR}/.env
    volumes:
      - db:/var/lib/postgresql
      - /etc/localtime:/etc/localtime:ro
    networks:
      - internal

  fpm:
    image: erpuserside/userside:3.21-fpm
    restart: unless-stopped
    depends_on:
      - postgres
      - redis
      - rabbitmq
    env_file:
      - ${ERP_BASE_DIR}/.env
    volumes:
      - www:/app/userside
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
      - ${ERP_BASE_DIR}/config/datetime.ini:/usr/local/etc/php/conf.d/timezone.ini
      #- ${ERP_BASE_DIR}/config/php.ini:/usr/local/etc/php/php.ini
      #- ${ERP_BASE_DIR}/config/error.ini:/usr/local/etc/php/conf.d/error.ini
      #- ${ERP_BASE_DIR}/config/www.conf:/usr/local/etc/php-fpm.d/www.conf
    networks:
      - internal

  php:
    image: erpuserside/userside:3.21-php
    env_file:
      - ${ERP_BASE_DIR}/.env
    volumes:
      - www:/app/userside
      - backup:/backup
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
      - ${ERP_BASE_DIR}/config/datetime.ini:/usr/local/etc/php/conf.d/timezone.ini
      #- ${ERP_BASE_DIR}/config/php.ini:/usr/local/etc/php/php.ini
    networks:
      - internal

  core-worker:
    image: erpuserside/userside:3.21-php
    restart: unless-stopped
    depends_on:
      - postgres
      - redis
      - rabbitmq
    env_file:
      - ${ERP_BASE_DIR}/.env
    volumes:
      - www:/app/userside
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
    networks:
      - internal
    command: php /app/userside/run queue/listen
    deploy:
      replicas: 10

  poller:
    image: erpuserside/usm_poller:3.21
    restart: unless-stopped
    depends_on:
      - rabbitmq
      - core-worker
    env_file:
      - ${ERP_BASE_DIR}/data/userside/.env
    networks:
      - internal
    deploy:
      replicas: 10

  nginx:
    image: erpuserside/userside:3.21-nginx
    restart: unless-stopped
    ports:
      - "172.31.254.1:8080:80"
    volumes:
      - www:/app/userside
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
    depends_on:
      - fpm
    networks:
      - internal
    logging:
      driver: "json-file"
      options:
        max-file: "10"
        max-size: "20m"

  redis:
    image: redis:alpine
    restart: unless-stopped
    volumes:
      - redis:/data
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
    networks:
      - internal
    command: redis-server --requirepass ${REDIS_PASSWORD}

  rabbitmq:
    image: erpuserside/userside:3.21-rabbitmq
    hostname: ${PROJECT_NAME}_rabbitmq
    restart: unless-stopped
    env_file:
      - ${ERP_BASE_DIR}/.env
    volumes:
      - rabbitmq:/var/lib/rabbitmq
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
    networks:
      - internal
    ports:
      # - "172.31.254.1:5672:5672" # AMQP for external access
      - "172.31.254.1:15672:15672" # RabbitMQ management
      - "172.31.254.1:15674:15674" # WebSTOMP (websocket)

volumes:
  www:
    driver_opts:
      type: none
      device: ${ERP_BASE_DIR}/data/userside
      o: bind
  backup:
    driver_opts:
      type: none
      device: ${ERP_BASE_DIR}/data/backup
      o: bind
  db:
    driver_opts:
      type: none
      device: ${ERP_BASE_DIR}/data/db
      o: bind
  redis:
  rabbitmq:


networks:
  internal:
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: 172.31.254.0/25
